    {
      "key": "part_holder",
      "title": "Operation 1",
      "action": "Print the two pieces laid out in the box STL. Slide one M3 nut into the middle side slot on each body rail. Leave those slots empty when you need both M3 bores clear.",
      "loose_parts": {
        "holder": 1,
        "nut": 2
      }
    },
    {
      "key": "aligned",
      "title": "Operation 2",
      "action": "With the device disconnected, align its body with the opening. Keep the bezel outside the holder.",
      "loose_parts": {
        "device": 1
      }
    },
    {
      "key": "seated",
      "title": "Operation 3",
      "action": "Press the body straight into the opening until the bezel sits flat. Check that the clips engage before mounting the holder.",
      "loose_parts": {}
    },
    {
      "key": "joined",
      "title": "Operation 4",
      "action": "Lay the wires in the bottom opening. Face the countersinks out and fit one M3 \u00d7 12 mm screw per side from the rear. For a patch panel, slide four M3 nuts from the wire opening into the plate.",
      "loose_parts": {
        "plate": 1,
        "screw": 2
      }
    }
